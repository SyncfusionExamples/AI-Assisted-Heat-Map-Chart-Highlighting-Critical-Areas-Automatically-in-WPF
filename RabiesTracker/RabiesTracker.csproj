<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\RabisImage.png" />
    <None Remove="Resources\RabiesData.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Images\RabisImage.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <EmbeddedResource Include="Resources\RabiesData.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.3.0-beta.2" />
    <PackageReference Include="Azure.Identity" Version="1.16.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="9.0.1-preview.1.24570.5" />
    <PackageReference Include="Syncfusion.SfBusyIndicator.WPF" Version="*" />
    <PackageReference Include="Syncfusion.SfHeatMap.WPF" Version="*" />
    <PackageReference Include="Syncfusion.SfTextInputLayout.WPF" Version="*" />
  </ItemGroup>

</Project>
